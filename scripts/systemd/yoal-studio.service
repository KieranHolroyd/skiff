[Unit]
Description=Yoal database studio (on demand)
Documentation=https://github.com/KieranHolroyd/yoal/blob/main/docs/build-plan/plans/22-native-studio.md
# Started only by the helper's POST /v1/studio/start verb when the agent sees a studio request.
# An agent update runs `systemctl try-restart yoal-studio.service` after restarting the agent, so a
# running studio moves to the new binary and a stopped one stays stopped.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=yoal
Group=yoal
# /run/yoal is setgid caddy (2770), so creating studio.sock there needs the group. The
# socket comes out 0660 yoal:caddy; the agent (also yoal) is the only client.
SupplementaryGroups=caddy
UMask=0007
WorkingDirectory=/opt/yoal/current/agent

# No EnvironmentFile: the studio never talks to the control plane, holds no node token, and gets
# each session's credentials from the agent over the socket.
Environment=YOAL_STUDIO_SOCKET=/run/yoal/studio.sock

ExecStart=/opt/yoal/current/agent/yoal-agent studio

# The process exits 0 after 5 idle minutes; on-failure leaves that clean exit stopped.
Restart=on-failure
RestartSec=1
TimeoutStopSec=10
KillSignal=SIGTERM
LimitNOFILE=4096
TasksMax=64
# Its own cgroup, separate from the agent's MemoryMax=192M: an OOM kill here never picks the agent.
MemoryMax=256M

# The agent's sandbox, minus netlink (no node metrics) and with only the runtime socket writable.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service io_uring_setup io_uring_enter io_uring_register
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=

ReadWritePaths=/run/yoal

# Deliberately no [Install] section: the unit is static, so `systemctl enable` refuses it and
# nothing starts it at boot. A node that never opens a studio never runs it.
