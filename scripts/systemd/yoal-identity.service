[Unit]
Description=Yoal identity (user pools)
Documentation=https://github.com/KieranHolroyd/yoal/blob/main/docs/IAM.md
After=network-online.target
Wants=network-online.target
# Started only by the helper's POST /v1/identity/start verb on the identity node. An agent update
# runs `systemctl try-restart yoal-identity.service` after restarting the agent, so a running identity
# process moves to the new binary and a stopped one stays stopped. Its database survives restarts.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=yoal
Group=yoal
# /run/yoal is setgid caddy (2770), so creating identity.sock there needs the group. The
# socket comes out 0660 yoal:caddy; the agent (also yoal) is the only client.
SupplementaryGroups=caddy
UMask=0007
WorkingDirectory=/opt/yoal/current/agent

# No EnvironmentFile with secrets: the identity process holds pool signing keys in its own SQLite
# file and never sees the node token. The agent pushes the non-secret pool projection over the
# unix socket. Optional operator overrides (data dir, origin, mail relay, master key).
Environment=YOAL_IDENTITY_SOCKET=/run/yoal/identity.sock
Environment=YOAL_IDENTITY_DATA_DIR=/var/lib/yoal/identity
Environment=YOAL_IDENTITY_PORT=8788
Environment=YOAL_IDENTITY_HOST=127.0.0.1
EnvironmentFile=-/etc/yoal/identity.env

ExecStart=/opt/yoal/current/agent/yoal-agent identity

Restart=always
RestartSec=2
TimeoutStopSec=30
KillSignal=SIGTERM
LimitNOFILE=4096
TasksMax=128
# Its own cgroup, separate from the agent's MemoryMax: an OOM kill here never picks the agent.
MemoryMax=256M

# The SQLite file and its -wal/-shm companions. StateDirectory creates it owned by User= and keeps
# it writable under ProtectSystem.
StateDirectory=yoal/identity
StateDirectoryMode=0700

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service io_uring_setup io_uring_enter io_uring_register
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=

ReadWritePaths=/run/yoal

# Deliberately no [Install] section: the unit is static, so `systemctl enable` refuses it and
# nothing starts it at boot except the identity node's agent.
