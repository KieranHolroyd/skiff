[Unit]
Description=Skiff Caddy edge proxy (admin API on a unix socket only)
Documentation=https://github.com/kieranholroyd/private-cloud-deploys/blob/main/docs/OPS.md
After=network-online.target
Wants=network-online.target
Before=skiff-control-plane.service skiff-agent.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=caddy
Group=skiff-caddy
# The setgid /run/skiff directory makes the admin socket group skiff-caddy (0660),
# so the agent can connect while nothing can reach an admin API on TCP.
UMask=0007
Environment=HOME=/var/lib/skiff/caddy
Environment=XDG_DATA_HOME=/var/lib/skiff/caddy/data
Environment=XDG_CONFIG_HOME=/var/lib/skiff/caddy/config

# --resume reloads the last config the agent applied (autosave.json under XDG_CONFIG_HOME), so a
# restart keeps every site route; the Caddyfile is only used on the very first start. The agent
# also re-applies its config if it ever finds Caddy running without it.
ExecStart=/opt/skiff/current/caddy/caddy run --resume --config /etc/caddy/skiff.Caddyfile --adapter caddyfile
ExecReload=/opt/skiff/current/caddy/caddy reload --config /etc/caddy/skiff.Caddyfile --adapter caddyfile --address unix//run/skiff/caddy-admin.sock

Restart=on-failure
RestartSec=2
TimeoutStopSec=20
KillSignal=SIGTERM
LimitNOFILE=1048576
TasksMax=128
MemoryMax=256M

# Binding 80/443 is the only privilege Caddy needs. It has no other capabilities.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service io_uring_setup io_uring_enter io_uring_register
SystemCallErrorNumber=EPERM

ReadWritePaths=/var/lib/skiff/caddy /run/skiff

[Install]
WantedBy=multi-user.target
