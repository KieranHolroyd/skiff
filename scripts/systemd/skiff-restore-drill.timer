[Unit]
Description=Run the Skiff restore drill monthly
Documentation=https://github.com/kieranholroyd/private-cloud-deploys/blob/main/docs/OPS.md

[Timer]
# First of the month at 04:17 local time, with jitter so every install does not hit R2
# at the same moment. Persistent=true catches up after a reboot or suspend.
OnCalendar=*-*-01 04:17:00
RandomizedDelaySec=30m
AccuracySec=1m
Persistent=true
Unit=skiff-restore-drill.service

[Install]
WantedBy=timers.target
