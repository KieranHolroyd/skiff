[Unit]
Description=Yoal control plane (dashboard, REST, MCP)
Documentation=https://github.com/kieranholroyd/private-cloud-deploys/blob/main/docs/OPS.md
After=network-online.target yoal-caddy.service yoal-clickhouse.service
Wants=network-online.target yoal-clickhouse.service
# Caddy is the only ingress. Starting the control plane without it is safe (sites and
# the agent keep running), so this is deliberately not a hard Requires=. The same goes for
# ClickHouse (hot telemetry): without it telemetry reports unavailable and nothing else breaks.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=yoal
Group=yoal
# The runtime directory is setgid yoal-caddy, so the unix socket created here is
# group-owned by yoal-caddy and Caddy can connect without joining the yoal group.
SupplementaryGroups=yoal-caddy
UMask=0007
WorkingDirectory=/opt/yoal/current/control-plane

EnvironmentFile=/etc/yoal/yoal.env
Environment=NODE_ENV=production
Environment=SOCKET_PATH=/run/yoal/control.sock
Environment=PROTOCOL_HEADER=x-forwarded-proto
Environment=HOST_HEADER=x-forwarded-host
# adapter-bun caps request bodies at 512 KB unless told otherwise, which makes Bun reject
# any local-store artifact upload over that with a bare 413. Allow the full artifact limit
# (limits.artifactBytes, 500 MiB) plus headroom; the upload route enforces the real limit.
Environment=BODY_SIZE_LIMIT=520M
Environment=YOAL_MASTER_KEY_FILE=%d/master-key
# The master key is delivered as a systemd credential, not through the environment.
LoadCredential=master-key:/etc/yoal/master.key

ExecStart=/opt/yoal/current/control-plane/runtime/bun /opt/yoal/current/control-plane/build/index.js

Restart=on-failure
RestartSec=2
TimeoutStopSec=35
KillSignal=SIGTERM
LimitNOFILE=65535
TasksMax=256
MemoryMax=1G

# Sandboxing. ProtectSystem=strict makes everything read-only except the paths below;
# the control plane only writes its SQLite data, local objects and the runtime socket.
# Telemetry goes to yoal-clickhouse over loopback HTTP, which has its own sandbox.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service io_uring_setup io_uring_enter io_uring_register
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=

ReadWritePaths=/var/lib/yoal /run/yoal

[Install]
WantedBy=multi-user.target
