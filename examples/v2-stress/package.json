{
	"name": "@yoal/example-v2-stress",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"build": "bun build src/server.ts --target=bun --outfile dist/server.js",
		"start": "bun src/server.ts",
		"serve": "bun dist/server.js",
		"dev": "PORT=3100 bun --watch src/server.ts",
		"provision": "bun scripts/provision.ts",
		"stress": "bun scripts/stress.ts",
		"check": "tsc -p . --noEmit"
	},
	"engines": {
		"bun": ">=1.4"
	}
}
