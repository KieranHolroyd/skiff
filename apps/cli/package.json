{
  "name": "@skiffy/skiff",
  "version": "0.2.0",
  "description": "CLI for Skiff, a lightweight self-hosted deploy platform",
  "keywords": ["skiff", "deploy", "static-site", "self-hosted", "cli", "paas"],
  "license": "MIT",
  "author": "Kieran Holroyd",
  "homepage": "https://github.com/KieranHolroyd/skiff#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KieranHolroyd/skiff.git",
    "directory": "apps/cli"
  },
  "bugs": "https://github.com/KieranHolroyd/skiff/issues",
  "type": "module",
  "bin": {
    "skif": "dist/skif.js",
    "skiff": "dist/skif.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "bun build src/main.ts --target=node --external esbuild --outfile dist/skif.js",
