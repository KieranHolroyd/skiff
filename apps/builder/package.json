{
	"name": "@skiff/builder",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"exports": { ".": "./src/main.ts" },
	"scripts": {
		"dev": "bun --watch src/main.ts",
		"start": "bun src/main.ts",
		"check": "tsc -p . --noEmit",
		"test": "bun test",
		"build": "bun build --compile --outfile dist/skiff-builder src/main.ts"
	},
	"dependencies": {
		"@skiff/contracts": "workspace:*",
		"fflate": "^0.8.3"
	},
	"engines": {
		"bun": ">=1.4"
	}
}
