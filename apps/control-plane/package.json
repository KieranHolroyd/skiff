		"@sveltejs/adapter-bun": "^1.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26",
		"bits-ui": "^2.20.0",
		"cn": "^0.5.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
