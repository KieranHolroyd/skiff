# Copy to .env (gitignored) or paste into the Arcane project's environment.

# The control plane the node pulls desired state from. Over WireGuard this is
# usually https://<platform host> pinned to the edge's tunnel address.
SKIFF_CONTROL_URL=https://control.example.com

# From `docker compose run --rm ... node join`, which writes node.json into the
# volume. Leave both empty after joining, or fill them in to skip the join.
SKIFF_NODE_ID=
SKIFF_NODE_TOKEN=

# The host address the edge proxies to: this host's WireGuard address, and the
# port Caddy listens on. The edge's node card must use the same host:port.
SKIFF_BIND_ADDRESS=10.88.0.2
SKIFF_HTTP_PORT=8080

# Image tag: `latest`, or a release version such as 0.6.3 to pin it.
SKIFF_IMAGE_TAG=latest
