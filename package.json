{
  "name": "skiff",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*", "spikes/*"],
  "scripts": {
    "check": "bun run --filter '*' check",
    "check:migrations": "bun scripts/check-migrations.ts",
    "test": "bun test",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "version:show": "bun scripts/version.ts show",
    "version:patch": "bun scripts/version.ts patch",
    "version:minor": "bun scripts/version.ts minor",
    "version:major": "bun scripts/version.ts major"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "aws4fetch": "^1.0.20",
    "typescript": "^7.0.2"
  }
}
